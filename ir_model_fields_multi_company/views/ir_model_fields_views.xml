<odoo>
    <record id="ir_model_fields_view_form" model="ir.ui.view">
        <field
            name="name"
        >ir.model.fields.form (in ir_model_fields_multi_company)</field>
        <field name="model">ir.model.fields</field>
        <field name="inherit_id" ref="base.view_model_fields_form" />
        <field name="arch" type="xml">
            <field name="readonly" position="after">
                <field name="allow_multi_company_write" />
            </field>
        </field>
    </record>
    <record id="ir_model_fields_view_tree" model="ir.ui.view">
        <field
            name="name"
        >ir.model.fields.tree (in ir_model_fields_multi_company)</field>
        <field name="model">ir.model.fields</field>
        <field name="inherit_id" ref="base.view_model_fields_tree" />
        <field name="arch" type="xml">
            <field name="readonly" position="after">
                <field name="allow_multi_company_write" optional="hide" />
            </field>
        </field>
    </record>
    <record id="ir_model_fields_view_search" model="ir.ui.view">
        <field
            name="name"
        >ir.model.fields.search (in ir_model_fields_multi_company)</field>
        <field name="model">ir.model.fields</field>
        <field name="inherit_id" ref="base.view_model_fields_search" />
        <field name="arch" type="xml">
            <filter name="translate" position="after">
                <separator />
                <filter
                    string="Allow Multi-Company Write"
                    name="allow_multi_company_write"
                    domain="[('allow_multi_company_write', '=', True)]"
                />
            </filter>
        </field>
    </record>
</odoo>
