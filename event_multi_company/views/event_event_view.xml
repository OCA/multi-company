<?xml version="1.0" ?>
<odoo>
    <record model="ir.ui.view" id="view_event_form_multi_company">
        <field name="name">event.event.form (multi-company)</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='right_event_details']/field[@name='company_id']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//group[@name='right_event_details']/field[@name='company_id']"
                position="after"
            >
                <field
                    name="company_ids"
                    groups="base.group_multi_company"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                />
            </xpath>
        </field>
    </record>
</odoo>
