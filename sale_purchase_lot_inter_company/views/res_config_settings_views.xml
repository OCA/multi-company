<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="sale_purchase_inter_company.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='inter_company_po_from_so']" position="after">
                <field
                    name="propagated_serial_number_so_po"
                    class="oe_inline"
                    attrs="{'invisible':['|', ('company_id', '=', False), ('po_from_so', '=', False)]}"
                />
                <label
                    string="Lots/Serial Numbers are propagated from sales in this company to purchase orders"
                    class="o_light_label"
                    for="propagated_serial_number_so_po"
                    attrs="{'invisible':['|', ('company_id', '=', False), ('po_from_so', '=', False)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
