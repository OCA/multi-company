<odoo>
    <record id="crm_lost_reason_form_view" model="ir.ui.view">
        <field
            name="name"
        >crm.lost.reason.form (in res_partner_category_multi_company)</field>
        <field name="model">crm.lost.reason</field>
        <field name="inherit_id" ref="crm.crm_lost_reason_view_form" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="company_id" groups="base.group_multi_company" />
                <field name="company_id" invisible="1" />
            </field>
        </field>
    </record>

    <record id="crm_lost_reason_tree_view" model="ir.ui.view">
        <field name="name">crm.lost.reason.list</field>
        <field name="model">crm.lost.reason</field>
        <field name="inherit_id" ref="crm.crm_lost_reason_view_tree" />
        <field name="arch" type="xml">
            <list>
                <field name="company_id" groups="base.group_multi_company" />
                <field name="company_id" column_invisible="1" />
            </list>
        </field>
    </record>
</odoo>
