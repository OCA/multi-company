<odoo>
    <record id="purchase_order_form" model="ir.ui.view">
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/list//field[@name='product_qty']"
                position="after"
            >
                <field name="display_qty_supplier_widget" column_invisible="True" />
                <field name="qty_supplier_widget_data" column_invisible="True" />
                <widget name="qty_supplier_widget" width="20px" />
            </xpath>
        </field>
    </record>
</odoo>
