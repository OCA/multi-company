<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="purchase_sale_stock_inter_company.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sync_picking']" position="after">
                <br invisible="not sync_picking" />
                <label
                    string="Through the transit receipt"
                    class="o_light_label mr8"
                    for="sync_picking_transit_receipt"
                    invisible="not sync_picking"
                />
                <field
                    name="sync_picking_transit_receipt"
                    invisible="not sync_picking"
                />
            </xpath>
        </field>
    </record>
</odoo>
