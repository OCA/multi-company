#. module: sale_purchase_inter_company
#. odoo-python
#: code:addons/sale_purchase_inter_company/models/sale_order_line.py:29
#, python-format
msgid "You cannot create PO from SO because product '%s' is not intercompany"
msgstr ""
"No puedes crear una orden de compra (PO) desde una orden de venta (SO) "
"porque el producto '%s' no es interempresa."

#. module: sale_purchase_inter_company
#. odoo-python
#: code:addons/sale_purchase_inter_company/models/sale_order_line.py:43
#: code:addons/sale_purchase_inter_company/models/sale_order_line.py:60
#: code:addons/sale_purchase_inter_company/models/sale_order_line.py:77
#: code:addons/sale_purchase_inter_company/models/sale_order_line.py:99
msgid "Warning"
msgstr "Aviso"

#. module: sale_purchase_inter_company
#. odoo-python
#: code:addons/sale_purchase_inter_company/models/sale_order_line.py:45
msgid ""
"Warning: changing the quantity here only updates the Sale Order (SO) and not "
"the Purchase Order (PO). If you want the quantity to be updated in both "
"synchronized orders, make the change in the PO."
msgstr ""
"Aviso: cambiar la cantidad aquí solo actualiza la orden de venta (SO) y no "
"la orden de compra (PO). Si quieres que la cantidad se actualice en ambas "
"órdenes sincronizadas, haz el cambio en la PO."

#. module: sale_purchase_inter_company
#. odoo-python
#: code:addons/sale_purchase_inter_company/models/sale_order_line.py:62
msgid ""
"Warning: changing the price here only updates the Sale Order (SO) and not "
"the Purchase Order (PO). If you want the price to be updated in both "
"synchronized orders, make the change in the PO."
msgstr ""
"Aviso: cambiar el precio aquí solo actualiza la orden de venta (SO) y no la "
"orden de compra (PO). Si quieres que el precio se actualice en ambas órdenes "
"sincronizadas, haz el cambio en la PO."

#. module: sale_purchase_inter_company
#. odoo-python
#: code:addons/sale_purchase_inter_company/models/sale_order_line.py:79
msgid ""
"Warning: changing the taxes here only updates the Sale Order (SO) and not "
"the Purchase Order (PO). If you want the taxes to be updated in both "
"synchronized orders, make the change in the PO."
msgstr ""
"Aviso: cambiar los impuestos aquí solo actualiza la orden de venta (SO) y no "
"la orden de compra (PO). Si quieres que los impuestos se actualicen en ambas "
"órdenes sincronizadas, haz el cambio en la PO."

#. module: sale_purchase_inter_company
#. odoo-python
#: code:addons/sale_purchase_inter_company/models/sale_order_line.py:101
msgid ""
"Warning: adding a product to an intercompany Sale Order (SO).\n"
"\n"
"Important: this line will NOT be created or updated in the Purchase Order "
"(PO).\n"
"If you want the line to exist and be synchronized in both orders, add it to "
"the PO."
msgstr ""
"Aviso: estás añadiendo un producto a una orden de venta (SO) interempresa.\n"
"\n"
"Importante: esta línea NO se creará ni actualizará en la orden de compra "
"(PO).\n"
"Si quieres que la línea exista y esté sincronizada en ambas órdenes, añádela "
"a la PO."

