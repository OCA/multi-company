<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.own.company.product</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='companies_setting_container']"
                position="inside"
            >
                <setting
                    id="multi_company_field_visible_product_setting"
                    string="Own company on products"
                    help="Let users without multi-company access see and set their own company on products."
                >
                    <field name="multi_company_field_visible_product" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
