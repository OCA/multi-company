<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="base.user_demo" model="res.users" context="{'no_reset_password': True}">
        <field name="company_id" ref="base.main_company" />
        <field
            name="company_ids"
            eval="[(4, ref('base.main_company')), (4, ref('res_company_demo'))]"
        />
        <field
            name="groups_id"
            eval="[(4, ref('res_users_single_active_company.group_single_active_company'))]"
        />
    </record>
</odoo>
