<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.own.company</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <!-- Sits next to the admin-only ``company_ids`` added by
                 partner_multi_company; shown only to non multi-company users. -->
            <xpath
                expr="//page[@name='sales_purchases']//field[@name='company_ids']"
                position="after"
            >
                <field
                    name="own_company_ids"
                    string="Company"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                    invisible="not show_own_company_field"
                    domain="[('id', 'in', allowed_company_ids)]"
                />
                <field name="show_own_company_field" invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
