<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="purchase_sale_inter_company.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <field name="sale_auto_validation" class="oe_inline" position="after">
                <br />
                <field name="propagated_serial_number" class="oe_inline" />
                <label
                    string="Propagated Lots in sale from purchase"
                    class="o_light_label"
                    for="propagated_serial_number"
                />
            </field>
        </field>
    </record>
</odoo>
