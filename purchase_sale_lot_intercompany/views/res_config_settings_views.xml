<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="purchase_sale_inter_company.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <div invisible="not company_id or not so_from_po" position="inside">
                <label
                    string="Propagated Lots from purchase to sale"
                    class="oe_inline o_light_label mr8"
                    for="propagated_serial_number"
                />
                <field name="propagated_serial_number" class="oe_inline" />
            </div>
        </field>
    </record>
</odoo>
