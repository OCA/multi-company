<odoo>
    <record id="view_res_company_representative_role_tree" model="ir.ui.view">
        <field name="name">res.company.representative.role.tree</field>
        <field name="model">res.company.representative.role</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="name">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="action_res_company_representative_role" model="ir.actions.act_window">
        <field name="name">Representative Roles</field>
        <field name="res_model">res.company.representative.role</field>
        <field name="view_mode">list</field>
        <field name="context">{}</field>
    </record>

    <menuitem
        id="menu_res_company_representative_role"
        name="Representative Roles"
        parent="menu_users_representative_settings"
        action="action_res_company_representative_role"
        sequence="200"
        groups="base.group_no_one"
    />
</odoo>
