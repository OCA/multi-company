<odoo>
    <record id="view_partner_category_form" model="ir.ui.view">
        <field
            name="name"
        >res.partner.category.form (in res_partner_category_multi_company)</field>
        <field name="model">res.partner.category</field>
        <field name="inherit_id" ref="base.view_partner_category_form" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="company_id" groups="base.group_multi_company" />
            </field>
        </field>
    </record>

    <record id="view_partner_category_list" model="ir.ui.view">
        <field
            name="name"
        >res.partner.category.tree (in res_partner_category_multi_company)</field>
        <field name="model">res.partner.category</field>
        <field name="inherit_id" ref="base.view_partner_category_list" />
        <field name="arch" type="xml">
            <list position="inside">
                <field name="company_id" groups="base.group_multi_company" />
            </list>
            <field name="parent_id" position="attributes">
                <attribute
                    name="domain"
                >[('id', '!=', id), ('company_id', 'in', [company_id, False])]</attribute>
            </field>
        </field>
    </record>
</odoo>
