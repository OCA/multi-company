<odoo>
    <record id="product_supplierinfo_form_view_inter_company" model="ir.ui.view">
        <field
            name="name"
        >product.supplierinfo.form.product_pricelist_inter_company</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view" />
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field
                    name="pricelist_item_id"
                    readonly="1"
                    invisible="not pricelist_item_id"
                    options="{'no_open': True}"
                />
            </field>
        </field>
    </record>

    <record id="product_supplierinfo_list_view_inter_company" model="ir.ui.view">
        <field
            name="name"
        >product.supplierinfo.list.product_pricelist_inter_company</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_tree_view" />
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field
                    name="pricelist_item_id"
                    optional="hide"
                    readonly="1"
                    options="{'no_open': True}"
                />
            </field>
        </field>
    </record>
</odoo>
