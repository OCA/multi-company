<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form_intercompany" model="ir.ui.view">
        <field name="name">stock.picking.form.intercompany</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <header position="inside">
                <field name="can_create_out_counterpart" invisible="1" />
                <button
                    name="action_create_counterpart"
                    invisible="not can_create_out_counterpart"
                    string="Create Counterpart"
                    groups="stock.group_stock_manager"
                    type="object"
                />
            </header>
        </field>
    </record>
</odoo>
